<section id="connect" class="section connect" aria-labelledby="connect-title">
  <div>
    <span class="eyebrow">LET’S KEEP IN TOUCH</span>

    <h2 id="connect-title">
      Good things<br />
      start with<br />
      <em>staying in touch.</em>
    </h2>

    <p>
      Receive community stories, programme updates, upcoming activities,
      and opportunities to get involved.
    </p>

    <span class="community-note">Together, we grow.</span>
  </div>

  <form
    id="newsletter-form"
    class="signup"
    action="https://gmail.us2.list-manage.com/subscribe/post?u=0cbdaf19c289bd187464344c2&amp;id=0c7b3e900d&amp;f_id=0094c2e1f0"
    method="post"
    aria-labelledby="newsletter-heading"
    aria-describedby="newsletter-status"
  >
    <h3 id="newsletter-heading">Stay connected</h3>

    <label for="newsletter-name">Your name</label>
    <input
      id="newsletter-name"
      name="FNAME"
      type="text"
      autocomplete="name"
      placeholder="Full name"
      required
    />

    <label for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      name="EMAIL"
      type="email"
      autocomplete="email"
      placeholder="you@example.com"
      required
    />

    <div class="consent">
      <input id="newsletter-consent" type="checkbox" required />
      <label for="newsletter-consent">
        I would like to receive Al-Bustan Association’s newsletter by email.
      </label>
    </div>

    <!-- Website Newsletter tag -->
    <div hidden>
      <input type="hidden" name="tags" value="13368" />
    </div>

    <!-- Mailchimp spam protection: leave this field empty. -->
    <div aria-hidden="true" style="position:absolute;left:-5000px;">
      <input
        type="text"
        name="b_0cbdaf19c289bd187464344c2_0c7b3e900d"
        tabindex="-1"
        value=""
        autocomplete="off"
      />
    </div>

    <button
      type="submit"
      name="subscribe"
      class="button"
      aria-describedby="newsletter-status"
      disabled
    >
      Join our newsletter
    </button>

    <div
      id="newsletter-feedback"
      class="newsletter-feedback"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-state="idle"
    >
      <span
        id="newsletter-feedback-icon"
        class="feedback-icon"
        aria-hidden="true"
        hidden
      ></span>

      <div>
        <strong id="newsletter-feedback-title" hidden></strong>
        <p id="newsletter-status">
          Enter your name and email to subscribe.
        </p>
      </div>
    </div>

    <noscript>
      <p class="fineprint">
        Please enable JavaScript to subscribe on this page.
      </p>
    </noscript>

    <p class="fineprint unsubscribe-note">
      One newsletter each month. Unsubscribe anytime using the link in any
      newsletter.
    </p>

    <a
      href="https://eepurl.com/lu2Cd02m0E"
      class="mailchimp-badge"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Mailchimp (opens in a new tab)"
    >
      <img
        src="https://digitalasset.intuit.com/render/content/dam/intuit/mc-fe/en_us/images/intuit-mc-rewards-text-dark.svg"
        alt="Intuit Mailchimp"
        width="220"
        height="40"
        loading="lazy"
      />
    </a>
  </form>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById("newsletter-form");

    if (!form || form.dataset.ready) return;

    form.dataset.ready = "true";

    const button = form.querySelector('button[type="submit"]');
    const status = document.getElementById("newsletter-status");
    const feedback = document.getElementById("newsletter-feedback");
    const feedbackTitle = document.getElementById(
      "newsletter-feedback-title"
    );
    const feedbackIcon = document.getElementById(
      "newsletter-feedback-icon"
    );

    let sending = false;
    button.disabled = false;

    const showMessage = (message, state) => {
      status.textContent = message;
      status.dataset.state = state;
      feedback.dataset.state = state;

      feedbackTitle.hidden = state === "idle";
      feedbackIcon.hidden = state === "idle";

      feedbackTitle.textContent =
        state === "success"
          ? "You're subscribed!"
          : state === "error"
            ? "Please check your signup"
            : "Joining our community…";

      feedbackIcon.textContent =
        state === "success" ? "✓" : state === "error" ? "!" : "…";
    };

    form.addEventListener("submit", (event) => {
      // Keep the visitor on this page.
      event.preventDefault();

      if (sending) return;

      for (const field of ["FNAME", "EMAIL"]) {
        const input = form.elements.namedItem(field);
        input.value = input.value.trim();
      }

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const url = new URL(form.action);

      // Mailchimp's embedded-form JSONP endpoint.
      url.pathname = url.pathname.replace(
        "/subscribe/post",
        "/subscribe/post-json"
      );

      for (const [name, value] of data.entries()) {
        if (typeof value === "string") {
          url.searchParams.set(name, value);
        }
      }

      const callbackName =
        "bustanNewsletter_" +
        Date.now() +
        "_" +
        Math.random().toString(36).slice(2);

      url.searchParams.set("c", callbackName);

      const script = document.createElement("script");
      let finished = false;

      sending = true;
      button.disabled = true;
      button.textContent = "Submitting…";
      form.setAttribute("aria-busy", "true");

      showMessage("Submitting your signup…", "pending");

      const cleanup = () => {
        finished = true;
        clearTimeout(timer);
        script.remove();

        // Ignore late responses after a timeout.
        window[callbackName] = () => {};

        setTimeout(() => {
          delete window[callbackName];
        }, 60000);

        sending = false;
        button.disabled = false;
        button.textContent = "Join our newsletter";
        form.removeAttribute("aria-busy");
      };

      const timer = setTimeout(() => {
        if (finished) return;

        cleanup();

        showMessage(
          "We could not confirm your signup. Check your inbox before trying again, or contact us below.",
          "error"
        );
      }, 20000);

      window[callbackName] = (response) => {
        if (finished) return;

        cleanup();

        if (response && response.result === "success") {
          form.reset();

          showMessage(
            "Thank you for joining our community. You'll receive our newsletter every month by email.",
            "success"
          );
        } else {
          // Display text only; never inject Mailchimp response HTML.
          const message =
            typeof response?.msg === "string"
              ? new DOMParser()
                  .parseFromString(response.msg, "text/html")
                  .body.textContent.trim()
              : "";

          showMessage(
            message ||
              "We could not complete your signup. Please try again or contact us below.",
            "error"
          );
        }
      };

      script.onerror = () => {
        if (finished) return;

        cleanup();

        showMessage(
          "Unable to reach Mailchimp. Check your connection and try again.",
          "error"
        );
      };

      script.src = url.href;
      document.body.appendChild(script);
    });
  })();
</script>

