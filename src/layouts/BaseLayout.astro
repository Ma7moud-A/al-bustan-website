---
interface Props {
  title?: string;
  description?: string;
}

import "../styles/global.css";

const {
  title = "Al-Bustan Association | Silwan, Jerusalem",
  description = "Discover Al-Bustan Association’s community programmes, activities and opportunities to get involved.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  </head>

  <body>
    <slot />
  </body>
</html>
